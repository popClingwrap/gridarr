{
  "name": "gridarr",
  "version": "2.0.0",
  "type": "module",
  "description": "Zero-dependency 2D grid engine using 1D flat buffers and lazy generators.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/popClingwrap/gridarr"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "grid",
    "matrix",
    "game-engine",
    "generators",
    "2d",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
